# Railway / runtime
NODE_ENV=production
PORT=3011

# Mongo
MONGO_URL=mongodb://127.0.0.1:27017/
MONGO_DB=maiditt

# Redis: shares Socket.IO rooms, login attempts and used captchas between workers.
# Without it the server runs as a single process and keeps that state in memory.
REDIS_HOST=redis://127.0.0.1:6379
# Number of worker processes; defaults to the CPU count. Only used with REDIS_HOST.
WEB_CONCURRENCY=2

# Auth / cookies
SESSION_SECRET=
COOKIE_SECURE=true
CORS_ORIGINS=https://your-frontend.up.railway.app
# Comma-separated emails allowed to review selfie verifications
MODERATOR_EMAILS=

# AWS
AWSAccessKeyId=
AWSSecretKey=
AWSBucketName=
# Private bucket for verification selfies (same region, no public read). Falls back to AWSBucketName.
AWS_VERIFICATION_BUCKET=

# Email (Mailgun)
# EU accounts must set MAILGUN_API_URL=https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net
emailfrom=Sugrit <noreply@sugrit.com>
returnUrlEmail=https://www.sugrit.com
GOOGLE_REDIRECT_URI=https://www.sugrit.com/api/users/google/callback
