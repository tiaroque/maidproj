# Railway / runtime
NODE_ENV=production
PORT=3000

# Mongo
MONGO_URL=mongodb://127.0.0.1:27017/
MONGO_DB=maiditt

# Redis: shares Socket.IO rooms, login attempts and used captchas between workers.
# Without it the server runs as a single process and keeps that state in memory.
REDIS_HOST=redis://127.0.0.1:6379
# Number of worker processes; defaults to the CPU count. Only used with REDIS_HOST.
WEB_CONCURRENCY=2

# Auth / cookies
SESSION_SECRET=
COOKIE_SECURE=true
CORS_ORIGINS=https://your-frontend.up.railway.app
# Comma-separated emails allowed to review selfie verifications
MODERATOR_EMAILS=

# Browse-by-location pages (/{lang}/browse/{country}/{city}[/{service}]).
# A place needs this many cleaners to get a page at all; below it, 404.
BROWSE_PAGE_MIN_PROFILES=1
# And this many to be indexed and listed in the sitemap. Between the two the
# page renders and stays internally linked, but carries noindex.
BROWSE_INDEX_MIN_PROFILES=5
# Service pages are a slice of a city, so they index on a lower bar.
BROWSE_SERVICE_INDEX_MIN_PROFILES=3

# AWS
AWSAccessKeyId=
AWSSecretKey=
AWSBucketName=
# Private bucket for verification selfies (same region, no public read). Falls back to AWSBucketName.
AWS_VERIFICATION_BUCKET=

# Email (Mailgun)
# EU accounts must set MAILGUN_API_URL=https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net
emailfrom=linpura <noreply@linpura.com>
returnUrlEmail=https://www.linpura.com
GOOGLE_REDIRECT_URI=https://www.linpura.com/api/users/google/callback

# Facebook Login (developers.facebook.com > App settings > Basic)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://www.linpura.com/api/users/facebook/callback

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@linpura.com
